# ─── Frontend (apps/web) ─────────────────────────────────────────────────────

# Leave empty to use Next.js API routes on the same domain (recommended for Vercel).
# Set this only if the Express API backend is deployed separately.
NEXT_PUBLIC_API_URL=

# WebSocket URL — only needed if self-hosting the standalone Express API backend.
# Leave empty on Vercel (real-time uses polling automatically).
NEXT_PUBLIC_WS_URL=
